{
  "info": {"name":"OneEnterprise - Tenant Management Service - Sprint 2","description":"Rayi Mohan Tenant Management Sprint 2: provisioning, isolation, backup strategy, advanced configuration and lifecycle validation.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8083"},{"key":"tenantId","value":""}],
  "item":[
    {"name":"1. Create Tenant + Provisioning","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"tenantCode\": \"S2MOHAN01\",\n  \"tenantName\": \"Sprint 2 Mohan Tenant\",\n  \"legalName\": \"Sprint 2 Mohan Tenant Private Limited\",\n  \"contactEmail\": \"mohan.sprint2@example.com\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"locale\": \"en-IN\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants","host":["{{baseUrl}}"],"path":["api","tenants"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 201', () => pm.response.to.have.status(201));","const json=pm.response.json();","pm.expect(json.id).to.exist;","pm.collectionVariables.set('tenantId',json.id);"]}}]},
    {"name":"2. Get Provisioning","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/provisioning","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","provisioning"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200',()=>pm.response.to.have.status(200));","const j=pm.response.json();","pm.expect(j.tenantId).to.eql(pm.collectionVariables.get('tenantId'));","pm.expect(j.status).to.eql('PROVISIONED');"]}}]},
    {"name":"3. Verify Isolation","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/isolation","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","isolation"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200',()=>pm.response.to.have.status(200));","const j=pm.response.json();","pm.expect(j.tenantId).to.eql(pm.collectionVariables.get('tenantId'));","pm.expect(j.isolationMode).to.exist;"]}}]},
    {"name":"4. Update Advanced Configuration","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"currency\": \"INR\",\n  \"dateFormat\": \"dd-MM-yyyy\",\n  \"emailEnabled\": true,\n  \"notificationsEnabled\": true,\n  \"selfServiceEnabled\": true,\n  \"maxUsers\": 500,\n  \"dataRetentionDays\": 730,\n  \"maxStorageMb\": 20480,\n  \"sessionTimeoutMinutes\": 60,\n  \"auditEnabled\": true,\n  \"backupEnabled\": true,\n  \"backupRetentionDays\": 90,\n  \"passwordMinLength\": 14,\n  \"defaultRole\": \"USER\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/configuration","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","configuration"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200',()=>pm.response.to.have.status(200));","const j=pm.response.json();","pm.expect(j.dataRetentionDays).to.eql(730);","pm.expect(j.maxStorageMb).to.eql(20480);","pm.expect(j.backupRetentionDays).to.eql(90);"]}}]},
    {"name":"5. Request Backup","request":{"method":"POST","url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/backups","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","backups"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 202',()=>pm.response.to.have.status(202));","const j=pm.response.json();","pm.expect(j.tenantId).to.eql(pm.collectionVariables.get('tenantId'));","pm.expect(j.backupType).to.eql('POSTGRESQL_LOGICAL');","pm.expect(j.status).to.eql('REQUESTED');"]}}]},
    {"name":"6. Backup History","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/backups","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","backups"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().length).to.be.greaterThan(0);"]}}]},
    {"name":"7. Get Status","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/status","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","status"]}}},
    {"name":"8. PENDING -> ACTIVE","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"ACTIVE\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/status","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","status"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().status).to.eql('ACTIVE');"]}}]},
    {"name":"9. ACTIVE -> SUSPENDED","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"SUSPENDED\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/status","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","status"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200',()=>pm.response.to.have.status(200));","pm.expect(pm.response.json().status).to.eql('SUSPENDED');"]}}]},
    {"name":"10. Invalid SUSPENDED -> PENDING","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"PENDING\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/status","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","status"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 400',()=>pm.response.to.have.status(400));","pm.expect(pm.response.json().message).to.include('Invalid tenant status transition');"]}}]},
    {"name":"11. SUSPENDED -> ACTIVE","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"ACTIVE\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/status","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","status"]}}},
    {"name":"12. Deactivate Tenant","request":{"method":"DELETE","url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 204',()=>pm.response.to.have.status(204));"]}}]},
    {"name":"13. Invalid INACTIVE -> ACTIVE","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"ACTIVE\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/status","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","status"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 400',()=>pm.response.to.have.status(400));","pm.expect(pm.response.json().message).to.include('Invalid tenant status transition');"]}}]},
    {"name":"14. Invalid Configuration Validation","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"currency\": \"\",\n  \"dateFormat\": \"yyyy\",\n  \"maxUsers\": 0,\n  \"dataRetentionDays\": 0,\n  \"maxStorageMb\": 1,\n  \"sessionTimeoutMinutes\": 1,\n  \"backupRetentionDays\": 0,\n  \"passwordMinLength\": 2,\n  \"defaultRole\": \"\"\n}"},"url":{"raw":"{{baseUrl}}/api/tenants/{{tenantId}}/configuration","host":["{{baseUrl}}"],"path":["api","tenants","{{tenantId}}","configuration"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 400',()=>pm.response.to.have.status(400));"]}}]}
  ]
}
